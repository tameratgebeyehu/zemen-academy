{
  "name": "zemen-academy",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "generate:katex-css": "node scripts/generate-katex-css.mjs",
    "start": "expo start",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "lint": "tsc --noEmit",
    "audit:v1": "node scripts/v1-release-audit.mjs",
    "audit:backend": "node scripts/verify-production-backend.mjs",
    "audit:content": "node scripts/verify-production-content.mjs",
    "audit:public": "node scripts/verify-public-release-urls.mjs",
    "verify:v1": "npm run audit:v1 && npm run typecheck && npm test -- --runInBand && npx expo install --check",
    "export:android-check": "expo export --platform android --output-dir outputs/gate6-export-check --clear",
    "preflight:gate6": "node scripts/gate6-preflight.mjs",
    "verify:gate6": "npm run preflight:gate6 && npm run verify:v1 && npm run audit:public && npm run audit:backend && npm run audit:content && npm run export:android-check"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-navigation/bottom-tabs": "^7.18.10",
    "@react-navigation/native": "^7.3.10",
    "@react-navigation/native-stack": "^7.18.2",
    "expo": "~57.0.13",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.11",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.12",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-notifications": "~57.0.11",
    "expo-screen-capture": "~57.0.2",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "katex": "0.17.0",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-paper": "^5.15.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.86.2",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.3",
    "jest": "29.7.0",
    "jest-expo": "~57.0.4",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ]
  }
}
